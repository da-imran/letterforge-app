# LetterForge App - Root environment template
# Copy to .env and fill in values for local development.
#
# The packages read their own .env files from inside packages/<pkg>/.
# This file exists for documentation and shared root-level overrides only.

# --- Backend (packages/server) ---
# These mirror the keys expected by packages/server/.env.example
HOSTNAME=localhost
ROUTE_PREPEND=letter-forge
API_VERSION=1.0.0
APP_VERSION=1.0.0
VERSION=v1
PORT=8888
SERVICE_NAME=letter-forge
MONGO_URI=mongodb://localhost:27017/
MONGODB_DBNAME=data
NODE_ENV=local

# --- Frontend (packages/dashboard) ---
NEXT_PUBLIC_API_URL=http://localhost:8888
NEXT_PUBLIC_API_BASE=/letter-forge/v1
