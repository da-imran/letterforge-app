{
  "name": "@letterforge-app/server",
  "version": "1.0.0",
  "description": "LetterForge backend API server - Express + MongoDB word game engine",
  "keywords": [
    "letterforge",
    "backend",
    "express",
    "mongodb"
  ],
  "author": "Muhammad Ehsan Imran",
  "license": "MIT",
  "type": "commonjs",
  "main": "index.js",
  "private": true,
  "scripts": {
    "bootstrap": "bash scripts/bootstrap.sh",
    "swagger": "node swagger/swagger.js",
    "build": "npm run swagger",
    "test": "mocha \"**/test/*-test.js\"",
    "start": "node app.js",
    "dev": "nodemon --watch '**/*.js' --ignore 'test/**' --exec \"npm run swagger && node app.js\"",
    "lint": "eslint ."
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-openapi-validator": "^5.6.2",
    "mongodb": "^7.1.0",
    "swagger-autogen": "^2.23.7",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "chai": "^6.2.2",
    "eslint": "^10.0.0",
    "globals": "^17.3.0",
    "mocha": "^11.7.5",
    "nodemon": "^3.1.11",
    "sinon": "^21.0.1"
  }
}
