# LetterForge App - Root environment template
# Copy to .env and fill in values for local development.
#
# The packages read their own .env files from inside packages/<pkg>/.
# This file exists for documentation and shared root-level overrides only.

# --- Backend (packages/server) ---
# These mirror the keys expected by packages/server/.env.example
HOSTNAME=localhost
ROUTE_PREPEND=letter-forge
API_VERSION=1.0.0
APP_VERSION=1.0.0
VERSION=v1
PORT=8888
SERVICE_NAME=letter-forge
MONGO_URI=mongodb://localhost:27017/
MONGODB_DBNAME=data
NODE_ENV=local

# --- Message queue (RabbitMQ) ---
# Enables async score persistence. The API returns 202 Accepted and a
# background worker (npm run start:worker) records the score. Set to false to
# force the synchronous write path.
RABBITMQ_ENABLED=true
RABBITMQ_URI=amqp://localhost
RABBITMQ_QUEUE_SCORES=score.submitted
RABBITMQ_QUEUE_SCORE_RECORDED=score.recorded

# --- Frontend (packages/dashboard) ---
# NEXT_PUBLIC_API_URL is intentionally unset - the client derives the API
# host from the host serving the page (works for localhost AND LAN devices).
# To pin a remote API origin, set it explicitly here.
NEXT_PUBLIC_API_BASE=/letter-forge/v1
